{
  "name": "@eudiplo/client-next",
  "version": "0.0.0",
  "private": true,
  "description": "The rebuilt EUDIPLO Web Client: Angular, Tailwind CSS, spartan/ui and TanStack Query.",
  "scripts": {
    "ng": "ng",
    "dev": "node scripts/write-dev-env.mjs && ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,json}\""
  },
  "dependencies": {
    "@angular/cdk": "22.2.5",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@badgateway/oauth2-client": "^3.3.1",
    "@eudiplo/sdk-core": "workspace:*",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/lucide": "^36.1.0",
    "@ngx-formly/core": "^11.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "@spartan-ng/brain": "1.9.0",
    "@tanstack/angular-query-experimental": "5.107.1",
    "@tanstack/angular-table": "9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "keycloak-js": "^26.2.5",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.2",
    "tailwind-merge": "^3.7.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/qrcode": "^1.5.6",
    "angular-eslint": "22.6.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.0.5"
  }
}
